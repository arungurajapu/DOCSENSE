# DocSense Backend Configuration
# Copy to .env (in repository root or backend/) for local development. Never commit .env files.
# Settings resolves .env from repo root and backend/ regardless of working directory.
# Relative persistence paths (./data/..., sqlite:///./data/...) resolve relative to backend/.
# IMPORTANT: Run backend with --workers 1 (single-process SQLite/Chroma/lock boundary).

APP_NAME=DocSense
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
LOG_LEVEL=INFO

# Persistence paths (relative values resolve relative to backend/, or supply absolute paths)
DATABASE_URL=sqlite:///./data/docsense.db
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=docsense_chunks
UPLOAD_DIR=./data/uploads

# Embedding & Token Chunking (all-MiniLM-L6-v2 max_seq_length=256, reserves 2 tokens for [CLS]/[SEP])
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE_TOKENS=200
CHUNK_OVERLAP_TOKENS=40
MODEL_MAX_SEQ_LENGTH=256

# Upload constraints
MAX_UPLOAD_SIZE_MB=25

# CORS origins (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
